generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Job {
  id           String      @id @default(uuid())
  payload      Json
  priority     JobPriority @default(MEDIUM)
  status       JobStatus   @default(QUEUED)
  attempts     Int         @default(0)
  maxRetries   Int         @default(3)
  startedAt    DateTime?
  completedAt  DateTime?
  workerId     String?
  errorMessage String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  failedAt     DateTime?
  type         String
  userId       String

  @@index([userId])
  @@index([userId, status])
  @@index([status])
  @@index([status, createdAt])
  @@index([status, startedAt])
  @@index([completedAt])
  @@index([createdAt])
}

model OutboxEvent {
  id          String       @id @default(uuid())
  jobId       String
  streamName  String
  payload     Json
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  lastError   String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  publishedAt DateTime?

  @@index([status, createdAt])
  @@index([jobId])
}

enum JobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  DLQ
}

enum JobPriority {
  LOW
  MEDIUM
  HIGH
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED
}
