{
  "name": "taskflow",
  "version": "1.0.0",
  "description": "Production-hardened custom distributed job queue system",
  "main": "dist/api-service/server.js",
  "scripts": {
    "build": "tsc",
    "start": "ts-node api-service/server.ts",
    "start:worker": "ts-node worker-service/workers/worker.ts",
    "start:recovery": "ts-node recovery-service/scanner.ts",
    "start:alert": "ts-node alert-service/alert.ts",
    "dev": "nodemon --exec ts-node api-service/server.ts",
    "worker": "nodemon --exec ts-node worker-service/workers/worker.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "benchmark": "ts-node benchmark/index.ts"
  },
  "keywords": [
    "job-queue",
    "distributed-systems",
    "redis",
    "postgresql",
    "prisma",
    "priority-queue"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "axios": "^1.18.1",
    "dotenv": "^17.4.0",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.20.0",
    "prisma": "^7.5.0",
    "prom-client": "^15.1.3",
    "redis": "^5.11.0",
    "uuid": "^14.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.5.0",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^10.0.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^5.1.2"
  }
}