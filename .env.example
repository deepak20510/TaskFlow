# ========================================================
# TaskFlow Environment Configuration Example
# ========================================================

# PostgreSQL Database Connection String (Prisma)
# Example: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/taskflow?schema=public"

# Redis Server Connection URL
# Standalone local: redis://localhost:6379
# Cloud / TLS: rediss://default:PASSWORD@HOST:PORT
REDIS_URL="redis://localhost:6379"

# API Service Port (Default: 5000)
PORT=5000

# Worker Service Metrics Port (Default: 3001)
WORKER_METRICS_PORT=3001

# Node Environment ('development' | 'production' | 'test')
NODE_ENV="development"

# Security & Authentication
# Master API Key for service-to-service communication / benchmarking
API_KEY="taskflow-dev-api-key"
# Secret used to sign and verify JWT tokens
JWT_SECRET="taskflow-development-secret-change-in-production"

# Rate Limiting (Token Bucket)
# Maximum burst capacity
RATE_LIMIT_CAPACITY=100
# Refill rate (tokens per second)
RATE_LIMIT_REFILL_RATE=10
# Set to 'true' to reject requests if Redis is unreachable (default: false / fail-open)
RATE_LIMIT_FAIL_CLOSED=false

# Backpressure Queue Thresholds
# Soft limit starts slowing down incoming submissions
BACKPRESSURE_SOFT_LIMIT=5000
# Hard limit returns 429 System Overloaded
BACKPRESSURE_HARD_LIMIT=8000

# Benchmarking Configuration (Optional)
BENCHMARK_JOBS=100
BENCHMARK_BATCH_SIZE=50
BENCHMARK_API_URL="http://localhost:5000/jobs/batch"
BENCHMARK_BATCH_DELAY_MS=0
